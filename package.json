{
  "name": "@commonwealth/canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build:web": "rsbuild build",
    "build": "bun run build:web && bun run typecheck && bun run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src package.json tsconfig.json rsbuild.config.ts biome.json README.md smoke .github",
    "test": "bun test src",
    "test:browser": "bun run build:web && bun test ./smoke/browser-smoke.ts",
    "verify": "bun run typecheck && bun run lint && bun run build:web && bun test && bun run test:browser"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@tailwindcss/postcss": "^4.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
